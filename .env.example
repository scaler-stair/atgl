# ATGL Energy & Gas Intelligence: environment configuration.
# Copy to .env.local for development. Never commit real secrets (Section 8).

# development | staging | production. Drives the environment band and seeding rules.
APP_ENV=staging
# synthetic | live. Marks every screen and report.
DATA_MODE=synthetic
TENANT_ID=atgl
TENANT_NAME=Adani Total Gas

# Gemini (Executive Copilot and agent narratives). Leave empty to use the
# deterministic grounded responder. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model alias; pin a specific version for production releases (SOP-05).
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest

# Workflow database (users, sessions, audit, alerts, opportunities).
# Neon: Console > your project > Connect > turn OFF "Connection pooling" and copy the
# connection string (host without "-pooler"). Leave empty to use the local SQLite file.
DATABASE_URL=
DATABASE_POOL_SIZE=10
# Schema for the app tables. "atgl" keeps them out of any hosted data API.
# Serverless hosts using Neon's pooled endpoint (-pooler) must set this to "public".
DATABASE_SCHEMA=atgl
# Local SQLite file, used only when DATABASE_URL is empty.
DATABASE_PATH=data/atgl.db

SESSION_TTL_HOURS=10
SESSION_IDLE_MINUTES=60

# Staging/development only: password for the seeded demo accounts.
DEMO_USER_PASSWORD=
# Production only: initial platform admin password (must be changed at first sign-in).
BOOTSTRAP_ADMIN_PASSWORD=

# Shared secret for the scheduler calling POST /api/agents/run (Authorization: Bearer <secret>).
AGENT_SCHEDULER_TOKEN=
