{
  "name": "atgl-intelligence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "test:readonly": "tsx --conditions=react-server --test tests/controls.test.ts",
    "test:golden": "tsx --conditions=react-server --test tests/golden.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "backup": "node --env-file-if-exists=.env.local scripts/backup.mjs",
    "verify": "npm run typecheck && npm run lint && npm test",
    "uat": "node scripts/uat.mjs",
    "test:postgres": "node scripts/test-postgres.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "puppeteer-core": "^25.11.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.13"
  }
}
